---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import homeData from '../data/home.json';
import iconX from '../assets/navigation/twitter4x.png'
import iconGitHub from '../assets/navigation/github4x.png'
import { ViewTransitions } from 'astro:transitions';

const { title, seo } = Astro.props;

const documentationUrl = homeData.settings.documentationUrl;

const links = [
  {
    name: 'Home',
    url: '/',
    target: ''
  },
  {
    name: 'Learning',
    url: '/learning/',
    target: ''
  },
  {
    name: 'Pricing',
    url: '/pricing/',
    target: ''
  },
  {
    name: 'FAQ',
    url: '/faq/',
    target: ''
  },
  {
    name: 'Blog',
    url: '/blog/',
    target: ''
  },
  {
    name: 'Adopters',
    url: '/companies/',
    target: ''
  },
  {
    name: 'Join Us',
    url: '/join/',
    target: ''
  },
];

const socialLinks = [
  {
    name: 'GitHub',
    url: 'https://github.com/projectsveltos/sveltos',
    icon: iconGitHub,
    target: '_BLANK'
  },
  {
    name: 'X',
    url: 'https://x.com/projectsveltos/',
    icon: iconX,
    target: '_BLANK'
  }
];

const seoTitle = `${title} | Sveltos`;
const seoDescription = seo?.description ? seo.description : 'Sveltos is an open-source Kubernetes add-on controller for fleet management, multi-cluster add-on distribution, policy enforcement, and platform engineering at scale.';
const seoMetaImage = seo?.metaImage ? seo.metaImage : 'https://sveltos.projectsveltos.io/og-image.png';
const seoSlug = seo?.slug ? seo.slug : '';

const canonicalURL = `https://sveltos.projectsveltos.io/${seoSlug}`;

const jsonLd = seo?.jsonLd ? JSON.stringify(seo.jsonLd) : null;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={seoDescription} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sveltos" />
    <meta property="og:title" content={seoTitle}/>
    <meta property="og:description" content={seoDescription}/>
    <meta property="og:image" content={seoMetaImage}/>
    <meta property='og:url'  content={canonicalURL}/>
    <meta name="twitter:card" content="summary_large_image" />
    <meta name='twitter:url' content={canonicalURL}/>
    <meta name='twitter:title' content={seoTitle}/>
    <meta name='twitter:description' content={seoDescription}/>
    <meta name="twitter:image" content={seoMetaImage}/>
    <link rel="canonical" href={canonicalURL}/>
		<title>{seoTitle}</title>
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    <script
      defer
      data-domain="sveltos.projectsveltos.io"
      src="https://plausible.io/js/script.js"
    ></script>
    <ViewTransitions />
	</head>
	<body class="bg-background">
		<Navigation links={links} socialLinks={socialLinks} documentationUrl={documentationUrl} />
		<slot />
		<Footer links={links} socialLinks={socialLinks} documentationUrl={documentationUrl} />
	</body>
</html>
<style is:global>
  @tailwind base;
  @tailwind components;
  @tailwind utilities;

  @layer base {
    @font-face {
      font-family: 'Outfit';
      src: url('/fonts/Outfit-VariableFont_wght.ttf') format('truetype');
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'Plus Jakarta Sans';
      src: url('/fonts/PlusJakartaSans-VariableFont_wght.ttf') format('truetype');
      font-style: normal;
      font-display: swap;
    } 
    @font-face {
      font-family: 'Plus Jakarta Sans';
      src: url('/fonts/PlusJakartaSans-Italic-VariableFont_wght.ttf') format('truetype');
      font-style: italic;
      font-display: swap;
    }
  }
  html {
    font-family: 'Plus Jakarta Sans', Arial, Helvetica, sans-serif;
  }
  body {
    overflow-x: clip;
  }
  .container-spill {
    margin-left: 0;
    width: 100%;
    margin: auto;
    padding: 0 1.5rem;
    @media (min-width:640px){
      margin-left: calc((100% - 640px)/2);
      max-width: 640px;
    }
    @media (min-width:768px){
      margin-left: calc((100% - 768px)/2);
      max-width: 768px;
    }
    @media (min-width:1024px){
      margin-left: calc((100% - 1024px)/2);
      max-width: 1280px;
    }
    @media (min-width:1280px){
      margin-left: calc((100% - 1280px)/2);
      max-width: 1440px;
    }
    @media (min-width:1440px){
      margin-left: calc((100% - 1440px)/2);
      max-width: 1536px;
    }
    @media (min-width:1536px){
      margin-left: calc((100% - 1536px)/2);
      max-width: 1800px;
    }
  }
  h1 {
    font-family: 'Outfit', Arial, Helvetica, sans-serif;
    font-size: 2.75rem;
    font-style: normal;
    font-weight: 600;
    line-height: 1.1; 
    letter-spacing: -0.03em;
    @media (min-width:1280px){
      font-size: 4rem;
    }
  }
  h2 {
    font-family: 'Outfit', Arial, Helvetica, sans-serif;
    font-style: normal;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
    font-size: 2rem;
    @media (min-width: 640px) {
      font-size: 2.25rem;
    }
    @media (min-width: 1024px) {
      font-size: 2.5rem;
      margin-bottom: 0.75rem;
    }
    @media (min-width: 1440px) {
      font-size: 2.75rem;
      margin-bottom: 1rem;
    }
  }
  h3 {
    font-family: 'Outfit', Arial, Helvetica, sans-serif;
    font-size: 1.5rem;
    font-style: normal;
    font-weight: 500;
    line-height: 125%; /* 1.875rem */
  }
  h4 {
    font-family: 'Outfit', Arial, Helvetica, sans-serif;
    font-size: 1rem;
    font-style: normal;
    font-weight: 500;
    line-height: 125%; /* 1.875rem */
  }
  h5 {
    font-family: 'Outfit', Arial, Helvetica, sans-serif;
    font-size: .75rem;
    font-style: normal;
    font-weight: 500;
    line-height: 125%; /* 1.875rem */
  }
  h6 {
    font-family: 'Outfit', Arial, Helvetica, sans-serif;
    font-size: .5rem;
    font-style: normal;
    font-weight: 500;
    line-height: 125%; /* 1.875rem */
  }
  p {
    font-family: 'Plus Jakarta Sans', Arial, Helvetica, sans-serif;
    color: #3b4045; /* Stack UI black-600 equivalent */
    font-style: normal;
    font-weight: 400;
    font-size: 1.125rem;
    line-height: 1.5; 
    letter-spacing: -0.01em;
    @media (min-width: 1024px) {
      font-size: 1.25rem;
    }
  }
  p.hero {
    font-size: 1.75rem;
    font-style: normal;
    font-weight: 500;
    line-height: 130%;
    letter-spacing: -0.035rem;
  }
  .tag {
    display: block;
    font-family: 'Outfit', Arial, Helvetica, sans-serif;
    font-style: normal;
    font-weight: 500;
    line-height: 125%;
    margin-bottom: 0.5rem;
    font-size: 1.125rem;
    @media (min-width: 640px) {
      font-size: 1.1875rem;
    }
    @media (min-width: 1024px) {
      font-size: 1.4375rem;
      margin-bottom: 0.75rem;
    }
    @media (min-width: 1440px) {
      font-size: 1.5rem;
      margin-bottom: 1rem;
    }
    
  }
  main a{
    font-weight: 600;
    text-decoration: underline;
  }
  a.no-underline{
    text-decoration: none !important;
  }
  a.emphasized {
    border-radius: 2rem;
    padding:  0.125rem 0.75rem;
    letter-spacing: 0.0375rem;
    background: #E8E3DC;
    text-decoration: none !important;
  }
  a.emphasized:hover {
    opacity: 80%;
  }

  a.emphasized.branded {
    color: white;
    font-weight: 500;
    padding: 0.25rem 1.1875rem 0.4375rem 0.75rem;
    line-height: 1.7875rem;
    margin: 0 0.25rem;
    white-space: nowrap;
  }
  a.emphasized.branded::before {
    display: inline-block;
    width: 1.625rem;
    height: 1.625rem;
    margin-right: 0.75rem;
  }
  a.emphasized.github {
    background-color: #6E5494;
    padding-left: 0.5rem;
  }
  a.emphasized.github::before {
    content: url('/images/icons/gitHub-logo.svg');
    transform: translateY(7px);
  }
  a.emphasized.twitter {
    background-color: #1E1E1E;
  }
  a.emphasized.twitter:before {
    content: url('/images/icons/twitter-logo.svg');
    transform: translateY(5px);
  }

  @media (min-width: 768px) {
    a.emphasized.github::before {
      transform: translateY(6px);
    }
  }

  @media (min-width: 1024px) {
    a.emphasized.twitter::before {
      transform: translateY(3px);
    }

    a.emphasized.github::before {
      transform: translateY(4px);
    }
  }
  a.emphasized.external::after {
    content: url('/images/icons/external-link-icon.svg');
    display: inline-block;
    width: 0.75rem;
    height: 0.75rem;
    margin-left: 1rem;
    transform: scale(1.25) translateY(-2px);
  }
  @media (min-width: 1024px) {
    a.emphasized.external::after {
      transform: scale(1.25) translateY(-4px);
    }
  }

  /* Hide scrollbar for Chrome, Safari and Opera */
  .no-scrollbar::-webkit-scrollbar {
      display: none;
  }
  /* Hide scrollbar for IE, Edge and Firefox */
  .no-scrollbar {
      -ms-overflow-style: none;  /* IE and Edge */
      scrollbar-width: none;  /* Firefox */
  }
  .text-balance {
    white-space: balance;
  }
  .section-body-spacing{
    margin-bottom: 1.5rem;
    @media (min-width: 1024px) {
      margin-bottom: 1.125rem;
    }
    @media (min-width: 1440px) {
      margin-bottom: 1.5rem;
    }
  }
  .carousel-wrapper-right::after {
	  z-index: 1;
	  content: '';
	  position: absolute;
	  top: 0;
	  right: 0;
	  width: 8rem;
	  bottom: 0;
	  flex-shrink: 0;
	  background: linear-gradient(
		  270deg,
		  #FAFAFA 7.69%,
		  rgba(31, 22, 51, 0) 92.31%
	  );
  }
  .carousel-wrapper-left::before {
	  z-index: 1;
	  content: '';
	  position: absolute;
	  top: 0;
	  left: 0;
	  width: 8rem;
	  bottom: 0;
	  flex-shrink: 0;
	  background: linear-gradient(
		  90deg,
		  #FAFAFA 7.69%,
		  rgba(31, 22, 51, 0) 92.31%
	  );
  }
</style>