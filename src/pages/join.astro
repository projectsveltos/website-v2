---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Hero from '../components/Hero.astro';
import adoptHeroImage from '../assets/adopt/adoptHeroImage.png';
import MerchSection from '../components/MerchSection.astro';
import homeData from '../data/home.json';

import { getCollection } from 'astro:content';

const teamMembers = await getCollection('team');

const page = homeData;

const slackIcon = `<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M5.042 15.165a2.528 2.528 0 0 1-2.52 2.523A2.528 2.528 0 0 1 0 15.165a2.527 2.527 0 0 1 2.522-2.52h2.52v2.52zM6.313 15.165a2.527 2.527 0 0 1 2.521-2.52 2.527 2.527 0 0 1 2.521 2.52v6.313A2.528 2.528 0 0 1 8.834 24a2.528 2.528 0 0 1-2.521-2.522v-6.313zM8.834 5.042a2.528 2.528 0 0 1-2.521-2.52A2.528 2.528 0 0 1 8.834 0a2.527 2.527 0 0 1 2.521 2.522v2.52H8.834zM8.834 6.313a2.527 2.527 0 0 1 2.521 2.521 2.527 2.527 0 0 1-2.521 2.521H2.522A2.528 2.528 0 0 1 0 8.834a2.528 2.528 0 0 1 2.522-2.521h6.312zM18.958 8.834a2.528 2.528 0 0 1 2.522-2.521A2.528 2.528 0 0 1 24 8.834a2.527 2.527 0 0 1-2.52 2.52h-2.522V8.834zM17.687 8.834a2.527 2.527 0 0 1-2.521 2.52 2.527 2.527 0 0 1-2.521-2.52V2.522A2.528 2.528 0 0 1 15.166 0a2.528 2.528 0 0 1 2.521 2.522v6.312zM15.166 18.958a2.528 2.528 0 0 1 2.521 2.522A2.528 2.528 0 0 1 15.166 24a2.527 2.527 0 0 1-2.522-2.522v-2.52h2.522zM15.166 17.687a2.527 2.527 0 0 1-2.522-2.521 2.527 2.527 0 0 1 2.522-2.521h6.313A2.528 2.528 0 0 1 24 15.166a2.528 2.528 0 0 1-2.522 2.521h-6.312z"/></svg>`;

const seoMetaData = {
  description: 'Join the Sveltos community. Explore our merch store, meet the team, or book a session to learn more about Kubernetes fleet management.',
  slug: 'join/'
};

const heroData = {
  headline: "Be part of the Sveltos community",
  subhead: 'Connect with the team and community through our various channels. Join the conversation and help us shape the future of Kubernetes fleet management.',
  heroImage: "/images/background-images/joinus.png"
}
---

<Layout title="Join the Sveltos Community: Merch, Team & Sessions" seo={seoMetaData}>
  <header>
    <Hero
      variant="subpage"
      headline={heroData.headline}
      subhead={heroData.subhead}
      heroImage={heroData.heroImage}
      isWhiteBg={true}
      isSmall={true}
      imageWidthClass="lg:w-1/4"
    />
  </header>
  <main>
    <!-- MEET THE TEAM -->
    <Section sectionStyles="px-[1.5rem] py-[4rem] xl:py-[6rem]">
      <div class="max-w-5xl mx-auto">
        <span class="text-primary tag block mb-2 text-center">People behind Sveltos</span>
        <h2 class="text-center mb-12">Meet the Team</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 justify-center max-w-3xl mx-auto">
          {teamMembers.map((member) => (
            <div class="flex flex-col items-center text-center group">
              <div class="w-48 h-48 rounded-full overflow-hidden mb-6 border-4 border-primary/10 group-hover:border-primary/30 transition-all shadow-xl">
                <img src={member.data.image} alt={member.data.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              </div>
              <h3 class="text-2xl font-bold text-black mb-1">{member.data.name}</h3>
              <p class="text-primary font-semibold mb-4">{member.data.role}</p>
              <p class="text-gray text-[0.95rem] leading-relaxed mb-6 max-w-xs">{member.body}</p>
              <div class="flex gap-4">
                {member.data.github && (
                  <a href={member.data.github} target="_blank" class="text-gray hover:text-black transition-colors">
                    <img src="/images/icons/gitHub-logo.svg" alt="GitHub" class="w-6 h-6" />
                  </a>
                )}
                {member.data.linkedin && (
                  <a href={member.data.linkedin} target="_blank" class="text-gray hover:text-[#0077B5] transition-colors">
                     <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </Section>

    <!-- JOIN SLACK -->
    <Section sectionStyles="px-[1.5rem] py-[4rem] bg-gradient-to-br from-[#003366] to-[#00AEEF] text-white overflow-hidden relative">
        <div class="absolute top-0 right-0 w-1/2 h-full bg-white/10 blur-[150px] -mr-64 rounded-full"></div>
        <div class="max-w-4xl mx-auto flex flex-col items-center text-center relative z-10">
            <div class="w-20 h-20 bg-white/10 rounded-3xl flex items-center justify-center mb-8 backdrop-blur-sm border border-white/20">
                <Fragment set:html={slackIcon} />
            </div>
            <h2 class="text-white text-5xl font-bold mb-6 italic">Join the Conversation</h2>
            <p class="text-white/80 text-xl leading-relaxed mb-12 max-w-2xl">
                The Sveltos Slack community is the best place to get real-time help, share your ideas, and connect with other Kubernetes enthusiasts.
            </p>
            <a href="https://projectsveltos.slack.com/join/shared_invite/zt-1p9fubv9v-C_N2r~v~v~v~v~v~v~v~v" target="_blank" class="bg-white text-[#003366] px-12 py-5 rounded-full font-bold text-lg hover:scale-105 transition-all shadow-2xl">
                Jump into Slack
            </a>
        </div>
    </Section>

    <!-- EXPLORE MERCH -->
    <MerchSection />

    <!-- CONTRIBUTE -->
    <Section sectionStyles="px-[1.5rem] py-[8rem] bg-taupe/10">
        <div class="max-w-4xl mx-auto text-center">
            <span class="text-primary tag block mb-4">Open Source First</span>
            <h2 class="text-5xl font-bold mb-8">Ready to Contribute?</h2>
            <p class="text-gray text-xl leading-relaxed mb-12 max-w-2xl mx-auto">
                Sveltos is built by the community, for the community. Whether you're a developer, a documentation wizard, or a tester, we'd love to have you onboard.
            </p>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
                <div class="bg-white p-8 rounded-[2rem] border border-borderGray text-left shadow-sm hover:shadow-xl transition-all">
                    <div class="text-primary font-bold text-xs uppercase mb-4 tracking-tighter">Code</div>
                    <h4 class="text-xl font-bold mb-3">Fix Bugs</h4>
                    <p class="text-gray text-sm leading-relaxed">Check our 'help wanted' issues on GitHub and start coding.</p>
                </div>
                <div class="bg-white p-8 rounded-[2rem] border border-borderGray text-left shadow-sm hover:shadow-xl transition-all">
                    <div class="text-primary font-bold text-xs uppercase mb-4 tracking-tighter">Docs</div>
                    <h4 class="text-xl font-bold mb-3">Improve Docs</h4>
                    <p class="text-gray text-sm leading-relaxed">Help us make Sveltos easier to use for everyone.</p>
                </div>
                <div class="bg-white p-8 rounded-[2rem] border border-borderGray text-left shadow-sm hover:shadow-xl transition-all">
                    <div class="text-primary font-bold text-xs uppercase mb-4 tracking-tighter">Community</div>
                    <h4 class="text-xl font-bold mb-3">Share Feedback</h4>
                    <p class="text-gray text-sm leading-relaxed">Join Slack and tell us what features you need next.</p>
                </div>
            </div>
            <a href="https://github.com/projectsveltos/sveltos/blob/main/CONTRIBUTING.md" target="_blank" class="inline-flex items-center gap-3 text-primary font-bold text-xl hover:translate-x-2 transition-transform">
                Read Contributing Guide
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
        </div>
    </Section>
  </main>
</Layout>
