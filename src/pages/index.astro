---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Carousel from '../components/Carousel.jsx';
import Hero from '../components/Hero.astro';
import companies from '../data/companies.json';
import page from '../data/home.json';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const arrowIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>`;

const seoMeta = {
  description: 'Sveltos is an open-source Kubernetes controller for consistent configurations, policies, and add-on management across all your clusters. Manage your entire Kubernetes fleet from a single management plane.',
};

const heroButtons = page.hero.buttons;

const playIcon = `<svg width="28" height="28" viewBox="0 0 24 24" fill="white"><polygon points="5,3 19,12 5,21"/></svg>`;
const playIconSmall = `<svg width="14" height="14" viewBox="0 0 24 24" fill="white"><polygon points="5,3 19,12 5,21"/></svg>`;

// Fetch and sort tutorials
const allTutorials = (await getCollection('tutorials'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Helper for YouTube IDs
const getYoutubeId = (url) => {
    if (!url) return null;
    const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
    const match = url.match(regExp);
    return (match && match[2].length === 11) ? match[2] : null;
};
---

<Layout title="Sveltos: Kubernetes Fleet Management" seo={seoMeta}>
  <header>
    <Hero
      headline={page.hero.headline}
      subhead={page.hero.subhead}
      buttonsData={heroButtons}
    />
  </header>
  <main>
    {
        companies && <section class="w-full mb-[3.25rem] xl:ml-[-1rem] 2xl:ml-[1rem] 3xl:ml-[3.62rem]">
          <Carousel companies={companies} client:load client:only="react" />
        </section>
    }
    <section class="w-full py-16 lg:py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
      <p class="text-gray font-semibold mb-2 uppercase tracking-wide text-sm">{page.oss.tag}</p>
      <h2 class="text-3xl lg:text-4xl font-bold mb-12 max-w-3xl leading-tight text-black">{page.oss.heading}</h2>

      <div class="flex flex-col gap-8">
        {page.oss.features.slice(0, 6).map((f, i) => (
          <div class={`flex flex-col lg:flex-row bg-backgroundGray rounded-xl overflow-hidden ${i % 2 !== 0 ? 'lg:flex-row-reverse' : ''}`}>
            <div class="w-full lg:w-1/2 p-8 lg:p-12 flex flex-col justify-center">
              <img src={f.icon} alt={f.title} class="w-10 h-10 mb-6 object-contain" />
              <h3 class="text-2xl font-bold mb-4 text-black">{f.title}</h3>
              <p class="text-[1.125rem] text-gray mb-0 leading-relaxed">{f.desc}</p>
            </div>
            <div class={`w-full lg:w-1/2 p-8 flex items-center justify-center bg-white border border-[#eaeaea] ${i % 2 !== 0 ? 'border-r-0' : 'border-l-0'}`}>
               <img src={f.image || "/images/background-images/oss.svg"} alt="" class="w-full max-w-[450px] h-auto" />
            </div>
          </div>
        ))}
      </div>
      <div class="flex flex-col sm:flex-row justify-center items-center gap-4 mt-12">
          {page.oss.buttons.map(b => (
            <Button type={b.type} cta={b.text} url={b.url} iconName={b.hasArrowIcon ? 'arrow' : null} color={b.color} background={b.type === 'primary' ? 'primary' : 'transparent'} />
          ))}
      </div>
    </section>

    <section class="w-full bg-black text-white py-16 lg:py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <span class="bg-orange text-white text-sm font-bold px-3 py-1 uppercase tracking-wider mb-8 inline-block rounded-sm">{page.enterprise.tag}</span>
        <div class="flex flex-col lg:flex-row gap-16 lg:gap-24">
          <div class="w-full lg:w-5/12">
            <h2 class="text-2xl lg:text-3xl font-bold mb-6 text-white leading-[1.15]">{page.enterprise.heading}</h2>
            <img src={page.enterprise.image} alt="Security" class="w-full max-w-sm h-auto mt-8 opacity-90 hidden lg:block" />
          </div>
          <div class="w-full lg:w-7/12 flex flex-col justify-center gap-10">
            {page.enterprise.bullets.map(b => (
              <div class="border-t border-[#1e293b] pt-8">
                <h3 class="text-2xl font-bold mb-3 text-white">{b.title}</h3>
                <p class="text-[1.125rem] text-white opacity-80 leading-relaxed mb-0">{b.text}</p>
              </div>
            ))}
            <div class="flex flex-wrap gap-4 mt-8 pt-4 border-t border-[#1e293b]">
              <Button type="primary" cta="Get Pull Mode (Enterprise)" url="/pricing/" background="white" color="white" />
              <Button type="secondary" cta="Learn more" url="/pricing/" background="transparent" color="white-outline" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section class="w-full py-[5rem] px-[0.5rem] sm:px-[1rem] md:px-[1.5rem] lg:px-[2rem] xl:px-[1.5rem] 2xl:px-[3.62rem] 3xl:px-[6.62rem]">
      <div class="max-w-5xl mx-auto">
        <span class="text-primary tag block mb-2">{page.howItWorks.tag}</span>
        <h2 class="mb-8">{page.howItWorks.heading}</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {page.howItWorks.steps.map(({ step, title, desc }) => (
            <div class="bg-white border border-[#e8e8e8] rounded-xl p-5 shadow-sm hover:shadow-md transition-shadow duration-200">
              <div class="text-[11px] font-bold text-primary mb-2 tracking-widest">{step}</div>
              <h3 class="text-[1rem] font-semibold mb-2 text-black">{title}</h3>
              <p class="text-[0.875rem] text-gray font-normal leading-relaxed m-0">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- LEARNING CENTER -->
    <section class="w-full py-[5rem] px-[0.5rem] sm:px-[1rem] md:px-[1.5rem] lg:px-[2rem] xl:px-[1.5rem] 2xl:px-[3.62rem] 3xl:px-[6.62rem] bg-white border-t border-borderGray">
      <div class="max-w-6xl mx-auto">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
            <div class="max-w-2xl">
                <span class="text-primary tag block mb-2">Learning Center</span>
                <h2 class="mb-3">Tutorials, guides &amp; deep dives</h2>
                <p class="text-gray m-0">Learn how to get the most out of Sveltos with step-by-step video tutorials and written guides.</p>
            </div>
            <div class="flex shrink-0">
                <Button type="primary" cta="Explore Learning Center" url="/learning/" color="blue" />
            </div>
        </div>

        {allTutorials.slice(0, 1).map((t) => {
            const videoId = getYoutubeId(t.data.videoUrl);
            return (
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 bg-[#f8faff] border border-[#dce8f8] rounded-[2.5rem] overflow-hidden shadow-sm hover:shadow-xl transition-all duration-500 group">
                    <div class="lg:col-span-4 relative aspect-video overflow-hidden bg-black">
                        <a href={`/learning/${t.slug}/`} class="block w-full h-full no-underline">
                            {videoId ? (
                                <img
                                src={`https://img.youtube.com/vi/${videoId}/maxresdefault.jpg`}
                                alt={t.data.title}
                                class="w-full h-full object-cover opacity-90 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700"
                                loading="lazy"
                                />
                            ) : (
                                <div class="w-full h-full bg-primary/20 flex items-center justify-center">
                                    <span class="text-primary font-bold">Tutorial</span>
                                </div>
                            )}
                            <div class="absolute inset-0 flex items-center justify-center">
                            <div class="w-20 h-20 rounded-full bg-primary/90 flex items-center justify-center shadow-2xl group-hover:scale-110 transition-transform">
                                <Fragment set:html={playIcon} />
                            </div>
                            </div>
                        </a>
                    </div>
                    <div class="lg:col-span-8 p-8 lg:p-12 flex flex-col justify-center gap-6">
                        <div class="flex flex-col gap-4">
                            <span class="text-xs font-bold bg-primary/10 text-primary px-3 py-1 rounded-full w-fit uppercase tracking-widest">{t.data.tag}</span>
                            <h3 class="text-3xl font-bold text-black leading-tight">{t.data.title}</h3>
                            <p class="text-lg text-gray font-normal leading-relaxed m-0 line-clamp-3">{t.data.description}</p>
                        </div>
                        <div class="flex flex-wrap gap-4 pt-4">
                            <Button type="primary" cta="Watch Demo" url={`/learning/${t.slug}/`} color="blue" iconName="arrow" />
                        </div>
                    </div>
                </div>
            )
        })}

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 mt-12">
            {allTutorials.slice(1, 3).map((t) => {
                const videoId = getYoutubeId(t.data.videoUrl);
                return (
                    <div class="bg-white border border-[#e8e8e8] rounded-[2rem] p-6 flex flex-col md:flex-row gap-6 hover:shadow-lg transition-all group">
                        <a href={`/learning/${t.slug}/`} class="block relative shrink-0 w-full md:w-48 aspect-video rounded-xl overflow-hidden bg-black no-underline">
                            {videoId ? (
                                <img
                                src={`https://img.youtube.com/vi/${videoId}/mqdefault.jpg`}
                                alt={t.data.title}
                                class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity"
                                />
                            ) : (
                                <div class="w-full h-full bg-primary/10" />
                            )}
                            <div class="absolute inset-0 flex items-center justify-center">
                            <div class="w-10 h-10 rounded-full bg-primary/90 flex items-center justify-center">
                                <Fragment set:html={playIconSmall} />
                            </div>
                            </div>
                        </a>
                        <div class="flex flex-col gap-2">
                            <span class="text-[10px] font-bold text-primary uppercase tracking-widest">{t.data.tag}</span>
                            <h4 class="text-lg font-bold text-black leading-tight m-0">{t.data.title}</h4>
                            <p class="text-sm text-gray m-0 line-clamp-2">{t.data.description}</p>
                        </div>
                    </div>
                )
            })}
        </div>
      </div>
    </section>

    <!-- LATEST NEWS -->
    <section class="w-full py-[5rem] px-[0.5rem] sm:px-[1rem] md:px-[1.5rem] lg:px-[2rem] xl:px-[1.5rem] 2xl:px-[3.62rem] 3xl:px-[6.62rem] bg-white">
      <div class="max-w-5xl mx-auto">
        <span class="text-primary tag block mb-2">Latest News</span>
        <h2 class="mb-8">From the Sveltos blog</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {posts.map((post) => (
            <div class="bg-[#f8faff] border border-[#dce8f8] rounded-2xl p-6 flex flex-col gap-3 hover:-translate-y-1 hover:shadow-md transition-all duration-200">
              <div class="flex items-center gap-2">
                <span class="text-[10px] font-bold bg-primary text-white px-2 py-0.5 rounded-full uppercase">{post.data.tag}</span>
                <span class="text-[11px] text-gray">{post.data.pubDate.toLocaleDateString('en-us', { year:'numeric', month:'short', day:'numeric'})}</span>
              </div>
              <h3 class="text-[0.95rem] font-semibold text-black leading-snug">{post.data.title}</h3>
              <p class="text-[0.85rem] text-gray font-normal leading-relaxed m-0 flex-1 line-clamp-3">{post.data.description}</p>
              <a href={`/blog/${post.slug}`} class="text-primary text-[0.85rem] font-semibold no-underline hover:underline mt-1 flex items-center gap-1">
                Read article
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

  </main>
</Layout>
