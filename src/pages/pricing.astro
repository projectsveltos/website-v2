---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Hero from '../components/Hero.astro';
import Button from '../components/Button.astro';
import homeData from '../data/home.json';

import pricing from '../data/pricing.json';

const enterpriseImage = "/images/background-images/entreprise-support.png";
const priceTiers = pricing.tiers.map((tier) => ({
  label: tier.label,
  price: `${pricing.currency}${tier.price.toLocaleString()}`,
}));

const seoMetaData = {
  description: 'Sveltos Pricing: Open Source Free Forever with Enterprise-Grade Support. Tech Support, Pull Mode, and Priority Slack for your Kubernetes fleet.',
  slug: 'pricing/'
};

const checkIcon = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`;
const crossIcon = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="Not included"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>`;

// Cell values: "yes" renders a check mark, "no" renders a red cross, anything else is shown as text.
const comparisonRows = [
  { feature: 'Add-on distribution (Helm, Kustomize, YAML, ytt, Jsonnet)', community: 'yes', enterprise: 'yes' },
  { feature: 'Label-based cluster targeting', community: 'yes', enterprise: 'yes' },
  { feature: 'Deployment ordering and dependencies', community: 'yes', enterprise: 'yes' },
  { feature: 'Drift detection and remediation', community: 'yes', enterprise: 'yes' },
  { feature: 'Per-cluster templating', community: 'yes', enterprise: 'yes' },
  { feature: 'Event framework', community: 'yes', enterprise: 'yes' },
  { feature: 'Health checks (Lua, CEL, Prometheus metrics)', community: 'yes', enterprise: 'yes' },
  { feature: 'Notifications (Slack, Teams, Discord, webhook)', community: 'yes', enterprise: 'yes' },
  { feature: 'Multi-tenancy', community: 'yes', enterprise: 'yes' },
  { feature: 'Pull Mode', community: 'Up to 2 clusters', enterprise: 'All managed clusters' },
  { feature: 'Progressive Rollouts (ClusterPromotion)', community: 'Up to 2 ClusterPromotion instances', enterprise: 'Any number of instances' },
  { feature: 'Job-based health validation', community: 'no', enterprise: 'yes' },
  { feature: 'Least-privilege (namespace-scoped) agents', community: 'no', enterprise: 'yes' },
  { feature: 'MCP Server for AI-assisted operations', community: 'no', enterprise: 'yes' },
  { feature: 'Support', community: 'GitHub issues, community Slack', enterprise: 'Priority technical support, priority Slack' },
  { feature: 'CVE-patched image builds ahead of the next release', community: 'no', enterprise: 'yes' },
  { feature: 'Architectural guidance and best practices', community: 'no', enterprise: 'yes' },
  { feature: 'Priority bug fixes and feature requests', community: 'no', enterprise: 'yes' },
];
---

<Layout title="Pricing and Support: Sveltos" seo={seoMetaData}>
  <header>
    <Hero
      variant="standard"
      isImageLeft={true}
      heroImage={enterpriseImage}
      headline="OSS Free Forever. Built for Enterprise."
      subhead="Sveltos is and will always be open source. Our support plans are designed for teams that need production-grade reliability, security, and direct architectural guidance."
      isWhiteBg={true}
      isSmall={true}
      imageWidthClass="lg:w-1/3"
      buttonsData={[
        {
          text: "Talk to an expert",
          link: "/contact/",
          type: "primary",
          color: "blue",
          iconName: "arrow"
        }
      ]}
    />
  </header>

  <main>
    <!-- PRICING TIERS -->
    <Section sectionStyles="py-[3rem] px-[1.5rem] xl:px-[3.5rem] bg-white">
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch">
          <!-- OSS TIER -->
          <div class="border border-borderGray rounded-3xl p-8 flex flex-col hover:shadow-lg transition-shadow">
            <div class="mb-8">
              <span class="text-xs font-bold bg-gray/10 text-gray px-3 py-1 rounded-full uppercase tracking-widest">Community</span>
              <h2 class="text-3xl font-bold mt-4 mb-2">Open Source</h2>
              <p class="text-sm text-primary font-semibold mb-3">Free Forever.</p>
              <div class="text-4xl font-bold text-black">$0</div>
              <p class="text-gray mt-4">Free forever for everyone. No strings attached.</p>
            </div>
            <ul class="flex flex-col gap-4 mb-12 flex-1 text-black">
              <li class="flex items-center gap-3">
                <span class="text-teal font-bold" set:html={checkIcon} />
                <span>Core fleet management: distribution, ordering, drift detection, templating, events</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="text-teal font-bold" set:html={checkIcon} />
                <span>Pull Mode for up to 2 clusters</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="text-teal font-bold" set:html={checkIcon} />
                <span>Progressive Rollouts for up to 2 ClusterPromotion instances</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="text-teal font-bold" set:html={checkIcon} />
                <span>GitHub Issue Management</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="text-teal font-bold" set:html={checkIcon} />
                <span>Public Documentation</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="text-teal font-bold" set:html={checkIcon} />
                <span>Community Slack Support</span>
              </li>
            </ul>
            <Button type="secondary" cta="Get Started Free" url="https://projectsveltos.io/main/getting_started/install/quick_start/" color="primary" iconName="arrow" />
          </div>

          <!-- ENTERPRISE SUPPORT TIER -->
          <div class="border-2 border-primary rounded-3xl p-8 flex flex-col shadow-xl bg-primary/5 relative overflow-hidden">
            <div class="mb-8">
              <span class="text-xs font-bold bg-primary text-white px-3 py-1 rounded-full uppercase tracking-widest">Enterprise</span>
              <h2 class="text-3xl font-bold mt-4 mb-2">Enterprise Premium</h2>
              <p class="text-sm text-primary font-semibold mb-3">Scale with Confidence. Expert Support Included.</p>
              <div class="mt-3 bg-white border border-primary/25 rounded-xl px-4 py-2 flex flex-col text-black">
                {priceTiers.map((tier) => (
                  <div class="flex items-baseline justify-between gap-4 py-3 border-b border-borderGray">
                    <span class="font-semibold">{tier.label}</span>
                    <span><span class="text-2xl font-bold">{tier.price}</span> <span class="text-sm text-gray font-normal">/ year</span></span>
                  </div>
                ))}
                <div class="flex items-baseline justify-between gap-4 py-3">
                  <span class="font-semibold">{pricing.largeFleetLabel}</span>
                  <a href="/contact/" class="text-primary font-semibold no-underline hover:underline">Contact us</a>
                </div>
              </div>
              <p class="text-sm text-gray mt-3 mb-0">Licensed per managed cluster. Your management cluster is not counted.</p>
              <p class="text-gray mt-4">Expert guidance and production-grade reliability for your Kubernetes fleet.</p>
            </div>
            <p class="text-xs font-bold text-primary uppercase tracking-widest mb-4">Everything in Community, plus</p>
            <ul class="flex flex-col gap-4 mb-12 flex-1 text-black font-semibold">
              <li class="flex items-center gap-3">
                <span class="text-primary" set:html={checkIcon} />
                <span>Pull Mode on all managed clusters and Progressive Rollouts with no instance limit</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="text-primary" set:html={checkIcon} />
                <span>Job-Based Health Validation</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="text-primary" set:html={checkIcon} />
                <span>Least-Privilege Agents</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="text-primary" set:html={checkIcon} />
                <span>MCP Server for AI-Assisted Operations</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="text-primary" set:html={checkIcon} />
                <div class="flex items-center gap-1.5">
                  <span>Priority Technical Support</span>
                  <span class="text-[10px] bg-primary/10 text-primary px-2 py-0.5 rounded font-normal">SLA-Backed</span>
                </div>
              </li>
              <li class="flex items-center gap-3">
                <span class="text-primary" set:html={checkIcon} />
                <span>Priority Slack Channel</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="text-primary" set:html={checkIcon} />
                <span>Zero-Downtime Security Patches</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="text-primary" set:html={checkIcon} />
                <span>Priority Bug Fixes & Feature Requests</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="text-primary" set:html={checkIcon} />
                <span>Architectural Guidance & Best Practices</span>
              </li>
            </ul>
            <div class="flex flex-col gap-3">
              <Button type="primary" cta="Start with Enterprise" url="/contact/" color="blue" iconName="arrow" />
              <Button type="secondary" cta="Schedule a Consultation" url="/contact/" color="primary" iconName="arrow" />
            </div>
          </div>
        </div>

        <!-- CUSTOM DEV -->
        <div class="mt-12 bg-taupe/20 border border-borderGray rounded-2xl p-8 flex flex-col md:flex-row items-center justify-between gap-6">
          <div class="max-w-xl text-center md:text-left">
            <h3 class="text-xl font-bold text-black mb-2">Need Custom Development?</h3>
            <p class="text-gray m-0">Requiring a specific integration, custom addon, or dedicated feature? We offer custom development services tailored to your roadmap.</p>
          </div>
          <Button type="secondary" cta="Request a Quote" url="/contact/" color="black" iconName="arrow" />
        </div>
      </div>
    </Section>

    <!-- COMMUNITY VS ENTERPRISE COMPARISON -->
    <Section id="compare-plans" sectionStyles="py-[3rem] px-[1.5rem] xl:px-[3.5rem] bg-white">
      <div class="max-w-5xl mx-auto w-full">
        <span class="text-primary tag block mb-2">Compare Plans</span>
        <h2 class="text-3xl lg:text-4xl mb-8 leading-tight">Community vs. Enterprise</h2>
        <div class="overflow-x-auto border border-borderGray rounded-2xl">
          <table class="w-full text-left border-collapse min-w-[36rem]">
            <thead>
              <tr class="bg-backgroundGray">
                <th class="py-4 px-6 text-sm font-bold text-black">Feature</th>
                <th class="py-4 px-6 text-sm font-bold text-black">Community</th>
                <th class="py-4 px-6 text-sm font-bold text-primary">Enterprise</th>
              </tr>
            </thead>
            <tbody>
              {comparisonRows.map((row) => (
                <tr class="border-t border-borderGray">
                  <td class="py-4 px-6 text-[0.95rem] text-black">{row.feature}</td>
                  <td class="py-4 px-6 text-[0.95rem] text-gray">
                    {row.community === 'yes' ? <span class="text-teal inline-block" set:html={checkIcon} /> : row.community === 'no' ? <span class="text-[#d92d20] inline-block" set:html={crossIcon} /> : row.community}
                  </td>
                  <td class="py-4 px-6 text-[0.95rem] text-black font-medium">
                    {row.enterprise === 'yes' ? <span class="text-primary inline-block" set:html={checkIcon} /> : row.enterprise === 'no' ? <span class="text-[#d92d20] inline-block" set:html={crossIcon} /> : row.enterprise}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="text-gray mt-6 mb-2">
          If an Enterprise license expires, the Enterprise features stop working and every open-source feature keeps running.
        </p>
        <p class="text-gray mb-0">
          Need to make the case internally? Read the <a href="/business-case/" class="text-primary font-semibold">business case for your team</a>.
        </p>
      </div>
    </Section>

    <!-- ENTERPRISE OFFERINGS -->
    <Section id="enterprise-features" sectionStyles="py-[3rem] px-[1.5rem] xl:px-[3.5rem] bg-background">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <span class="text-primary tag block mb-2">Enterprise Features</span>
          <h2 class="text-4xl mb-4 leading-tight">Scalable, Secure, and Intelligent Deployments</h2>
          <p class="text-lg text-gray max-w-3xl mx-auto">
            Manage your entire Kubernetes fleet with enterprise-grade capabilities designed for security, scale, and intelligent operations.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <!-- Pull Mode -->
          <div class="bg-white rounded-2xl p-6 border border-borderGray hover:shadow-lg transition-shadow flex flex-col">
            <div class="w-12 h-12 rounded-2xl bg-primary/10 flex items-center justify-center shrink-0 mb-4">
              <span class="text-primary font-bold text-xl">1</span>
            </div>
            <strong class="text-lg text-black block mb-2">Pull Mode</strong>
            <p class="text-[0.9rem] text-gray m-0 leading-relaxed mb-2">
              Ideal for clusters behind firewalls, air-gapped environments, edge deployments, or highly regulated setups. Managed clusters pull configuration from the management cluster.
            </p>
            <ul class="text-[0.85rem] text-gray space-y-1.5 ml-0">
              <li class="flex items-start gap-2">
                <span class="text-primary mt-0.5 shrink-0">✓</span>
                <span>Zero inbound firewall rules requirement</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-0.5 shrink-0">✓</span>
                <span>Works with restricted networks and edge locations</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-0.5 shrink-0">✓</span>
                <span>Automatic re-sync when connectivity is restored</span>
              </li>
            </ul>
          </div>

          <!-- Progressive Rollout Pipelines -->
          <div class="bg-white rounded-2xl p-6 border border-borderGray hover:shadow-lg transition-shadow flex flex-col">
            <div class="w-12 h-12 rounded-2xl bg-primary/10 flex items-center justify-center shrink-0 mb-4">
              <span class="text-primary font-bold text-xl">2</span>
            </div>
            <strong class="text-lg text-black block mb-2">Progressive Rollout Pipelines</strong>
            <p class="text-[0.9rem] text-gray m-0 leading-relaxed mb-2">
              Deploy with confidence through staged environments. Promote configurations from QA to Staging to Production with automated health checks.
            </p>
            <ul class="text-[0.85rem] text-gray space-y-1.5 ml-0">
              <li class="flex items-start gap-2">
                <span class="text-primary mt-0.5 shrink-0">✓</span>
                <span>As many pipelines as you need</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-0.5 shrink-0">✓</span>
                <span>Manual or automatic promotion per stage</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-0.5 shrink-0">✓</span>
                <span>Health checks before and after advancing stages</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-0.5 shrink-0">✓</span>
                <span>Job-based active probes (smoke tests, connectivity checks)</span>
              </li>
            </ul>
          </div>

          <!-- Job-Based Health Validation -->
          <div class="bg-white rounded-2xl p-6 border border-borderGray hover:shadow-lg transition-shadow flex flex-col">
            <div class="w-12 h-12 rounded-2xl bg-primary/10 flex items-center justify-center shrink-0 mb-4">
              <span class="text-primary font-bold text-xl">3</span>
            </div>
            <strong class="text-lg text-black block mb-2">Job-Based Health Validation</strong>
            <p class="text-[0.9rem] text-gray m-0 leading-relaxed mb-2">
              Go beyond inspecting existing state. Deploy Kubernetes Jobs to actively run smoke tests, synthetic transactions, and connectivity probes.
            </p>
            <ul class="text-[0.85rem] text-gray space-y-1.5 ml-0 mt-auto">
              <li class="flex items-start gap-2">
                <span class="text-primary mt-0.5 shrink-0">✓</span>
                <span>Deploy Job manifests from ConfigMaps or Secrets</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-0.5 shrink-0">✓</span>
                <span>Automatic Job cleanup after completion</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-0.5 shrink-0">✓</span>
                <span>Status-driven results with detailed error messaging</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-0.5 shrink-0">✓</span>
                <span>Combinable with resource and metric health checks</span>
              </li>
            </ul>
          </div>

          <!-- Namespace-Scoped Agents -->
          <div class="bg-white rounded-2xl p-6 border border-borderGray hover:shadow-lg transition-shadow flex flex-col">
            <div class="w-12 h-12 rounded-2xl bg-primary/10 flex items-center justify-center shrink-0 mb-4">
              <span class="text-primary font-bold text-xl">4</span>
            </div>
            <strong class="text-lg text-black block mb-2">Least-Privilege Agents</strong>
            <p class="text-[0.9rem] text-gray m-0 leading-relaxed mb-2">
              Align Sveltos agents with the exact RBAC boundaries your cluster owners grant. Restrict drift detection to specific namespaces instead of cluster-wide access.
            </p>
            <ul class="text-[0.85rem] text-gray space-y-1.5 ml-0 mt-auto">
              <li class="flex items-start gap-2">
                <span class="text-primary mt-0.5 shrink-0">✓</span>
                <span>Credential-scoped drift detection and monitoring</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-0.5 shrink-0">✓</span>
                <span>Multi-tenant ready for separate namespace access</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-0.5 shrink-0">✓</span>
                <span>One annotation configures both agents</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-0.5 shrink-0">✓</span>
                <span>Eliminates over-broad watch scope errors</span>
              </li>
            </ul>
          </div>


          <!-- MCP Server -->
          <div class="bg-white rounded-2xl p-6 border border-borderGray hover:shadow-lg transition-shadow flex flex-col">
            <div class="w-12 h-12 rounded-2xl bg-primary/10 flex items-center justify-center shrink-0 mb-4">
              <span class="text-primary font-bold text-xl">5</span>
            </div>
            <strong class="text-lg text-black block mb-2">AI-Powered Management with MCP Server</strong>
            <p class="text-[0.9rem] text-gray m-0 leading-relaxed mb-2">
              Connect AI assistants directly to your Sveltos cluster. Manage operations through natural language commands and automated troubleshooting.
            </p>
            <ul class="text-[0.85rem] text-gray space-y-1.5 ml-0">
              <li class="flex items-start gap-2">
                <span class="text-primary mt-0.5 shrink-0">✓</span>
                <span>Natural language cluster management</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-0.5 shrink-0">✓</span>
                <span>Automated troubleshooting and diagnostics</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-0.5 shrink-0">✓</span>
                <span>Real-time cluster analysis and insights</span>
              </li>
            </ul>
          </div>

          <!-- Priority Patches & Feature Delivery -->
          <div class="bg-white rounded-2xl p-6 border border-borderGray hover:shadow-lg transition-shadow flex flex-col">
            <div class="w-12 h-12 rounded-2xl bg-primary/10 flex items-center justify-center shrink-0 mb-4">
              <span class="text-primary font-bold text-xl">6</span>
            </div>
            <strong class="text-lg text-black block mb-2">Priority Patches & Feature Delivery</strong>
            <p class="text-[0.9rem] text-gray m-0 leading-relaxed mb-2">
              Don't wait for the next scheduled release. Get CVE-patched images directly, and your feature requests get prioritized on our roadmap.
            </p>
            <ul class="text-[0.85rem] text-gray space-y-1.5 ml-0">
              <li class="flex items-start gap-2">
                <span class="text-primary mt-0.5 shrink-0">✓</span>
                <span>CVE-patched image builds ahead of the next release</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-0.5 shrink-0">✓</span>
                <span>No waiting on standard release cadence for security fixes</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-0.5 shrink-0">✓</span>
                <span>Feature requests prioritized for Enterprise customers</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-0.5 shrink-0">✓</span>
                <span>Direct engineering access for urgent issues</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </Section>
  </main>
</Layout>