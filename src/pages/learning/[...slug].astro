---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import Hero from '../../components/Hero.astro';
import homeData from '../../data/home.json';

const documentationUrl = homeData.settings.documentationUrl;

export async function getStaticPaths() {
  const tutorialEntries = await getCollection('tutorials');
  return tutorialEntries.map(entry => ({
    params: { slug: entry.slug }, props: { entry },
  }));
}

const tutorialEntries = (await getCollection('tutorials'))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const { entry } = Astro.props;
const { Content } = await entry.render();

const seoMeta = {
  description: entry.data.description,
  slug: `learning/${entry.slug}/`
};

// Extract Youtube ID if present
const getYoutubeId = (url) => {
    if (!url) return null;
    const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
    const match = url.match(regExp);
    return (match && match[2].length === 11) ? match[2] : null;
};

const videoId = getYoutubeId(entry.data.videoUrl);
---

<Layout title={`${entry.data.title}: Sveltos Learning Center`} seo={seoMeta}>
  <header>
    <Hero
      variant="blog"
      headline={entry.data.title}
      subhead="Watch the demo to see Sveltos in action below."
    />
  </header>
  <main>
    <Section sectionStyles="py-[5rem] px-[0.5rem] sm:px-[1rem] md:px-[1.5rem] lg:px-[2rem] xl:px-0" isFirst>
      <div class="max-w-7xl mx-auto px-4 lg:px-8">
        <div class="flex flex-col lg:flex-row gap-16">
            
            <!-- SIDEBAR: SYLLABUS -->
            <aside class="w-full lg:w-1/4 order-2 lg:order-1">
                <div class="sticky top-24">
                    <div class="mb-10">
                        <a href="/learning/" class="text-primary font-bold no-underline hover:underline flex items-center gap-2 mb-8">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="rotate-180"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                            Learning Center
                        </a>
                    </div>
                    
                    <div class="bg-primary/5 rounded-3xl p-8 border border-primary/10">
                        <h4 class="text-xs font-bold uppercase tracking-widest text-primary/60 mb-6">DEMOS</h4>
                        <div class="space-y-4">
                            {tutorialEntries.map(t => (
                                <a href={`/learning/${t.slug}/`} class={`block text-sm font-semibold no-underline transition-colors hover:text-primary ${t.slug === entry.slug ? 'text-primary' : 'text-gray/80 underline underline-offset-4 decoration-borderGray'}`}>
                                    {t.data.title}
                                </a>
                            ))}
                        </div>
                    </div>

                    <div class="mt-8 p-8 bg-black text-white rounded-3xl">
                        <h4 class="text-sm mb-4">Need help?</h4>
                        <p class="text-xs text-white mb-6 font-sans">Chat with us on GitHub or check the official docs.</p>
                        <a href={documentationUrl} target="_blank" class="block text-center bg-primary text-white py-3 rounded-xl font-bold no-underline text-sm hover:opacity-90 transition-opacity">
                            Open Full Docs
                        </a>
                    </div>
                </div>
            </aside>

            <!-- MAIN CONTENT -->
            <div class="w-full lg:w-3/4 order-1 lg:order-2">
                {videoId && (
                    <div class="mb-16 aspect-video rounded-[2.5rem] overflow-hidden shadow-2xl border border-borderGray bg-black">
                        <iframe
                            width="100%"
                            height="100%"
                            src={`https://www.youtube.com/embed/${videoId}`}
                            title="YouTube video player"
                            frameborder="0"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                            allowfullscreen
                        ></iframe>
                    </div>
                )}

                <article class="prose prose-xl prose-slate max-w-none 
                    prose-headings:font-display prose-headings:font-bold prose-headings:text-black
                    prose-p:text-black/80 prose-p:leading-relaxed prose-p:font-sans
                    prose-strong:text-black prose-strong:font-bold
                    prose-a:text-primary prose-a:font-bold prose-a:no-underline hover:prose-a:underline
                    prose-li:text-black/80">
                  <Content />
                </article>

                <div class="mt-24 pt-12 border-t border-borderGray flex flex-col items-center sm:flex-row sm:justify-between gap-8">
                    <div class="text-center sm:text-left">
                        <h3 class="mb-2">Stuck?</h3>
                        <p class="text-gray m-0">Join our community for help.</p>
                    </div>
                    <div class="flex gap-4">
                        <a href="/join/" class="bg-primary text-white px-8 py-4 rounded-2xl font-bold no-underline hover:scale-105 transition-transform shadow-lg">
                            Get Help in Community
                        </a>
                    </div>
                </div>
            </div>
        </div>
      </div>
    </Section>
  </main>
</Layout>
