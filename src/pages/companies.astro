---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import companies from '../data/companies.json';
import Button from '../components/Button.astro';
import Hero from '../components/Hero.astro';
import CarouselCard from '../components/CarouselCard';

const seoMetaData = {
  description: 'See the companies and teams that have adopted Sveltos for Kubernetes fleet management, multi-cluster add-on delivery, and GitOps-driven configuration management.',
  slug: 'companies/'
};

const heroData = {
  headline: "Sveltos Adopters",
  subhead: 'Companies and teams running Sveltos in production: from startups to enterprise platform teams.',
  heroImage: "/images/background-images/adopters.png",
  buttons: [
    {
      text: 'Get Started',
      link: '/join',
      type: 'primary',
      color: 'black'
    }
  ]
}
---


<Layout title="Sveltos Adopters: Kubernetes Fleet Management" seo={seoMetaData}>
  <header>
    <Hero
      variant="subpage"
      headline={heroData.headline}
      subhead={heroData.subhead}
      heroImage={heroData.heroImage}
      buttonsData={heroData.buttons}
      bottomMargin="2xl:-mb-12"
      isWhiteBg={true}
      isSmall={false}
      imageWidthClass="lg:w-1/3"
    />
  </header>
  <main>
    <Section>
      <div class="company-list w-full flex flex-wrap">
        <h2 class="pl-[3rem] pt-[3rem] mb-0 text-[1.5rem] font-[500] leading-[125%] mb-[2.62rem] justify-self-start w-1/2">
          Our Adopters
        </h2>
      </div>
      {
        companies && <div class="flex flex-wrap columns-1 md:columns-2 lg:columns-3 pb-[5rem] gap-y-[2.5rem] gap-x-[2.5rem] md:gap-x-[1rem] md:gap-y-[3rem] justify-center">
          {
            companies.map((company) => (
              <CarouselCard company={company} border />           
            ))
          }

        </div>
      }
      </div>
      <div class="relative cta w-full flex flex-wrap items-center justify-center min-h-[30rem] z-0">
        <div class="absolute top-0 right-0 bottom-0 left-0">
          <div class="absolute bg-[url('/images/background-images/companies-left.png')] bg-contain bg-no-repeat bg-left-bottom min-h-[15rem] w-1/3 lg:w-1/2 left-0 bottom-0"></div>
          <div class="absolute bg-[url('/images/background-images/companies-right.png')] hidden md:block bg-no-repeat bg-contain bg-right-bottom h-[10rem] lg:w-1/2 right-0 bottom-0"></div>
        </div>
        <div class="flex-col mx-auto w-4/12 pt-[10rem] lg:w-8/12 lg:max-w-none text-center justify-center lg:py-[12rem] z-10">
          <h2>Want to list your company?</h2>
          <div class="justify-center flex pt-10">
            <Button url="/join" type="secondary" color="black" cta="Join Sveltos"></Button>
          </div>
        </div>
      </div>
    </Section>
  </main>
    
</Layout>
