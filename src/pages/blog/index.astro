---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import Hero from '../../components/Hero.astro';
import Pagination from '../../components/Pagination.astro';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const pageSize = 6;
const posts = allPosts.slice(0, pageSize);
const lastPage = Math.ceil(allPosts.length / pageSize);

const seoMetaData = {
  description: 'Learn about the latest Sveltos releases, tutorials, and community success stories. Our blog covers Kubernetes fleet management, GitOps, and more.',
  slug: 'blog/'
};

const heroData = {
  headline: "Sveltos Community Blog",
  subhead: 'Insights, tutorials, and news from the front lines of Kubernetes fleet management. Written by the community, for the community.'
}
---

<Layout title="Sveltos Blog: Kubernetes Fleet Management and GitOps News" seo={seoMetaData}>
  <header>
    <Hero
      variant="blog"
      headline={heroData.headline}
      subhead={heroData.subhead}
    />
  </header>
  <main>
    <Section id="blog-list" sectionStyles="px-[1.5rem] py-[4rem] xl:py-[6rem]" isFirst>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 min-h-[45rem]">
        {posts.map((post) => (
          <div class="bg-white border border-[#e8e8e8] rounded-2xl overflow-hidden shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-200 flex flex-col h-[20rem]">
            <div class="p-6 flex flex-col gap-3 flex-1">
              <div class="flex items-center gap-2">
                <span class="text-[10px] font-bold bg-primary/10 text-primary px-2 py-0.5 rounded-full w-fit uppercase">{post.data.tag}</span>
                <span class="text-[11px] text-gray">{post.data.pubDate.toLocaleDateString('en-us', { year:'numeric', month:'short', day:'numeric'})}</span>
              </div>
              <h3 class="text-[1.1rem] font-semibold text-black leading-snug line-clamp-2 h-[2.8rem]">{post.data.title}</h3>
              <p class="text-[0.9rem] text-gray font-normal leading-relaxed m-0 flex-1 line-clamp-3">{post.data.description}</p>
              <a href={`/blog/${post.slug}`} class="text-primary font-semibold no-underline hover:underline mt-2 flex items-center gap-1 w-fit">
                Read Article
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </a>
            </div>
          </div>
        ))}
      </div>

      <Pagination 
        prevUrl={null} 
        nextUrl={allPosts.length > pageSize ? '/blog/2' : null} 
        currentPage={1} 
        lastPage={lastPage} 
      />
    </Section>
  </main>
</Layout>

<style is:global>
  /* Basic prose-like styling in case Tailwind Typography isn't installed */
  .prose h1, .prose h2, .prose h3 {
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: #000;
  }
  .prose p {
    margin-bottom: 1.5rem;
    font-size: 1.125rem;
    line-height: 1.75;
  }
  .prose ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .prose li {
    margin-bottom: 0.5rem;
  }
</style>
