---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import Hero from '../../components/Hero.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: post,
	}));
}

const post = Astro.props;
const { Content } = await post.render();

const seoMetaData = {
  description: post.data.description,
  slug: `blog/${post.slug}/`
};
---

<Layout title={`${post.data.title} | Sveltos Blog`} seo={seoMetaData}>
  <article>
    <header>
      <Hero
        variant="blog"
        headline={post.data.title}
        subhead={`${post.data.tag} | ${post.data.pubDate.toLocaleDateString('en-us', { year:'numeric', month:'short', day:'numeric'})} | By ${post.data.author}`}
        bottomMargin="2xl:-mb-10"
      />
    </header>
    <main>
      <Section sectionStyles="px-[1.5rem] py-[4rem] xl:py-[6rem]" isFirst>
        <div class="max-w-3xl mx-auto prose prose-lg prose-slate prose-headings:font-sans prose-headings:font-semibold prose-a:text-primary hover:prose-a:opacity-80 transition-all">
          <Content />
        </div>
      </Section>
    </main>
  </article>
</Layout>

<style is:global>

  .prose h1, .prose h2, .prose h3 {
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: #000;
  }
  .prose p {
    margin-bottom: 1.5rem;
    font-size: 1.125rem;
    line-height: 1.75;
  }
  .prose ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .prose li {
    margin-bottom: 0.5rem;
  }
</style>
