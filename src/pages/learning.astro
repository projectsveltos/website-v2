---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Hero from '../components/Hero.astro';
import homeData from '../data/home.json';
import heroImage from '../assets/learning/learningcenter.svg';

const page = homeData;
const tutorials = (await getCollection('tutorials'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const seoMetaData = {
  description: 'Learn Sveltos through hands-on videos: Watch real demos, walkthroughs, and deep-dives from the ProjectSveltos team and community.',
  slug: 'learning/'
};

// Helper for YouTube Thumbnails
const getYoutubeId = (url) => {
    if (!url) return null;
    const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
    const match = url.match(regExp);
    return (match && match[2].length === 11) ? match[2] : null;
};
---

<Layout title="Sveltos Learning Center: Kubernetes Tutorials & Demos" seo={seoMetaData}>
  <header>
    <Hero
      variant="standard"
      isImageLeft={true}
      heroImage={heroImage}
      headline="Sveltos Learning Center"
      subhead="Watch our demos to see how Sveltos simplifies Kubernetes add-ons management."
      isWhiteBg={true}
      isSmall={true}
      imageWidthClass="lg:w-1/4"
      buttonsData={[
        {
          text: "Go to Documentation",
          link: homeData.settings.documentationUrl,
          type: "primary",
          color: "blue",
          target: "_blank",
          iconName: "arrow"
        }
      ]}
    />
  </header>
  <main>
    <Section id="demos" sectionStyles="py-[5rem] px-[0.5rem] sm:px-[1rem] md:px-[1.5rem] lg:px-[2rem] xl:px-[1.5rem] 2xl:px-[3.62rem] 3xl:px-[6.62rem]">
      <div class="max-w-6xl mx-auto">
        

        <!-- UNIFIED CATALOG -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {tutorials.map((tutorial) => {
                const videoId = getYoutubeId(tutorial.data.videoUrl);
                return (
                    <div class="bg-white border border-[#e8e8e8] rounded-2xl overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-500 flex flex-col group relative">
                        <a href={`/learning/${tutorial.slug}/`} class="block relative w-full aspect-video overflow-hidden bg-black no-underline">
                            {videoId ? (
                                <img
                                src={`https://img.youtube.com/vi/${videoId}/maxresdefault.jpg`}
                                alt={tutorial.data.title}
                                class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity duration-500 group-hover:scale-105 transition-transform duration-700"
                                loading="lazy"
                                />
                            ) : (
                                <div class="w-full h-full bg-primary/20 flex items-center justify-center">
                                    <span class="text-primary font-bold">Tutorial</span>
                                </div>
                            )}
                        </a>
                        <div class="p-6 flex flex-col gap-4 flex-1">
                            <div class="flex justify-between items-start">
                                <span class="text-[11px] font-bold text-primary/60 uppercase tracking-widest">{tutorial.data.tag}</span>
                            </div>
                            <h3 class="text-xl font-bold text-black leading-tight group-hover:text-primary transition-colors">{tutorial.data.title}</h3>
                            <p class="text-[0.95rem] text-gray leading-relaxed m-0 flex-1 line-clamp-3">{tutorial.data.description}</p>
                            <a href={`/learning/${tutorial.slug}/`} class="text-black font-bold no-underline hover:text-primary mt-4 flex items-center gap-2 group-hover:translate-x-1 transition-transform">
                                Watch Demo
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                            </a>
                        </div>
                    </div>
                )
            })}
        </div>
        
      </div>
    </Section>
  </main>
</Layout>
