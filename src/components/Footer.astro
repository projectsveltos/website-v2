---
import { Image } from 'astro:assets';
import logoFooter from '../assets/navigation/logo-footer.png';

const date = new Date();
const year = date.getFullYear();

const { links, socialLinks, documentationUrl } = Astro.props;

---

<footer class="bg-backgroundGray border-t border-borderGray">
  <div class="px-[3rem] container mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl">
  <div class="w-full flex flex-col lg:flex-row justify-between items-center py-12 gap-8 lg:gap-0">
    <div class="w-full lg:w-2/12 flex justify-center lg:justify-start">
      <a href="/">
        <Image src={logoFooter} densities={[1.5, 2, 3, 4]} alt="Sveltos" />
      </a>
    </div>
    <div class="w-full lg:w-10/12 flex flex-col lg:flex-row items-center lg:justify-end gap-6 lg:gap-8">
      <ul class="flex flex-wrap justify-center lg:flex-nowrap gap-6 lg:gap-8">
        {
          links.map((link) => <li>
            <a href={link.url} target={link.target} class="text-[#526471] font-medium text-[0.875rem] hover:text-black transition-colors">{link.name}</a>
          </li>
          )
        }
        <li>
          <a href={documentationUrl} target="_blank" class="text-primary font-semibold text-[0.875rem] hover:opacity-80 transition-opacity">Documentation</a>
        </li>
      </ul>
      <ul class="flex gap-[0.38rem]">
        {
          socialLinks.map((link) => <li>
            <a href={link.url} target={link.target} class="h-[30px] w-[30px]"><Image src={link.icon} alt={link.name} class="h-[30px] w-[30px]" densities={[1,2,3,4]} /></a>
          </li>
          )
        }
      </ul>
    </div>

  </div>
  <hr class="border-[#dce8f8] w-full" />
  <div class="flex flex-col md:flex-row justify-between items-center py-8 gap-4">
    <p class="text-[#526471] text-[0.875rem] m-0 text-center md:text-left">Copyright © {year ? year : ''} sveltos.projectsveltos.io | All Rights Reserved</p>
    <div class="flex flex-wrap justify-center gap-4 md:gap-8 text-[0.875rem]">
      <a href="mailto:support@projectsveltos.io" class="text-[#526471] font-medium hover:text-primary transition-colors">support@projectsveltos.io</a>
      <a href="mailto:sales@projectsveltos.io" class="text-[#526471] font-medium hover:text-primary transition-colors">sales@projectsveltos.io</a>
    </div>
  </div>
  </div>
</footer>
