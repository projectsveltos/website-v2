---
const {type, cta, url, color, target, background = 'transparent', icon, iconName} = Astro.props;

const githubIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-github"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>`;
const arrowIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>`;
const starIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`;

const anchorTagClassList = `no-underline flex grow md:flex-[1 1 50%] lg:grow-0 lg:basis-auto lg:table-cell no-underline`;
const commonClassList = `px-[12px] py-[8px] lg:px-[16px] lg:py-[10px] rounded-[6px] text-[0.875rem] sm:text-[1rem] font-[500] leading-[130%] tracking-tight w-full xl:w-auto transition-colors duration-200`;
const primaryClassList = `bg-primary border border-primary ${commonClassList} text-white hover:bg-[#3d5ab8] hover:border-[#3d5ab8] shadow-sm`;
const secondaryClassList = `${commonClassList} bg-${background} border border-borderGray text-black hover:bg-black-100 hover:border-[#d6d9dc] shadow-sm`;
const secondaryWhiteClassList = `${commonClassList} bg-transparent border border-white text-white hover:bg-white/10 hover:border-white shadow-sm`;
const whiteClassList = `${commonClassList} bg-white border border-white text-black hover:bg-gray-100 shadow-md`;
const buttonTaupeClassList = `${commonClassList} bg-orange text-white hover:bg-[#d64e00] shadow-sm`;

const classList = (type, color) => {
  if (color === 'white' && type !== 'primary') {
    return whiteClassList;
  }
  if (type === 'secondary' && color === 'white-outline') {
    return secondaryWhiteClassList;
  }
  switch(type) {
    case 'primary':
      return primaryClassList;
    case 'taupe':
      return buttonTaupeClassList;
    default:
      return secondaryClassList;
  }
}

const renderIcon = () => {
  if (icon) return icon;
  if (iconName === 'github') return githubIcon;
  if (iconName === 'arrow') return arrowIcon;
  if (iconName === 'star') return starIcon;
  return null;
}

---

<a href={url} target={target} class:list={`${anchorTagClassList}`}>
  <button class:list={`${classList(type, color)} flex items-center justify-center gap-2`}>
    <span>{cta}</span>
    {renderIcon() && <Fragment set:html={renderIcon()} />}
  </button>
</a>
