---
import Section from './Section.astro';
---
<Section sectionStyles="px-[1.5rem] py-[8rem] bg-[#F1F1F1]">
  <div class="max-w-6xl mx-auto flex flex-col lg:flex-row items-center gap-20">
    <div class="lg:w-1/2">
        <div class="relative inline-block mb-4">
            <span class="text-primary tag m-0 font-bold">Sveltos Gear</span>
            <div class="absolute -top-1 -right-4 w-3 h-3 bg-red-500 rounded-full animate-ping"></div>
        </div>
        <h2 class="text-5xl font-bold mb-8 leading-tight italic text-black">Support with Style</h2>
        <p class="text-gray text-xl leading-relaxed mb-10">
            Grab some official Sveltos gear! From stickers to t-shirts, every purchase helps support the development of the project.
        </p>
        <div class="flex flex-col sm:flex-row gap-6">
            <a href="https://www.stickermule.com/sveltos" target="_blank" class="bg-black text-white px-10 py-5 rounded-full font-bold text-center hover:opacity-90 transition-all shadow-xl">
                Visit Merch Store
            </a>
        </div>
    </div>
    <div class="lg:w-1/2 relative w-full">
        <div class="absolute inset-0 bg-primary/10 blur-[100px] rounded-full scale-110"></div>
        <div class="relative bg-white/50 backdrop-blur-sm p-4 rounded-[3rem] border border-borderGray transform rotate-2 hover:rotate-0 transition-transform duration-700 shadow-2xl">
            <img src="/images/background-images/merch.png" alt="Sveltos Merch" class="w-full h-auto rounded-[2.5rem]" />
        </div>
    </div>
  </div>
</Section>
